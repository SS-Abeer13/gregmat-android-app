<?xml version="1.0" encoding="utf-8"?>
<!--
  MainActivityHappy is the launcher alias enabled by default (see
  AndroidManifest.xml), so this — not plain ic_launcher.xml — is the one
  actually shown on the home screen in practice. Big Book has no "mood"
  concept (that's a Vocab Pro streak-engagement feature this app never
  triggers), so every mood variant intentionally points at the same
  exam-clipboard icon rather than ever falling back to the mascot.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_bigbook_launcher_background" />
    <foreground android:drawable="@drawable/ic_bigbook_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_bigbook_launcher_foreground" />
</adaptive-icon>
