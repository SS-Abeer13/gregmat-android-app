    <path
        android:fillColor="#FF44403C"
        android:pathData="M54.6,65.8 a5.3,4.5 0 1,0 10.6,0 a5.3,4.5 0 1,0 -10.6,0 Z" />
    <!-- Faint text line on the lower page -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD6D3D1"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M50,75.0 L70,75.0" />
</vector>
