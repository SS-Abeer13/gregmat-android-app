<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar/notification small icon. Android renders this as a flat
  silhouette (fill color is ignored, only alpha/shape matters), so it's kept
  simple: an open-book outline for Vocab Pro. Overridden per-flavor at
  app/src/bigbook/res/drawable/ic_notification.xml with a distinct glyph so
  Big Book's notifications don't borrow the vocab study icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,4 L17,4 A2,2 0 0 1 19,6 L19,20 L7,20 A2,2 0 0 1 5,18 L5,6 A2,2 0 0 1 7,4 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M8,9 L15,9 M8,13 L15,13" />
</vector>
